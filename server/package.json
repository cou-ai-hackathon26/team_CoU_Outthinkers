{
  "name": "maternacare-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "predev": "npm run db:generate",
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && tsc",
    "prestart": "npm run db:generate",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:seed:locations": "tsx prisma/seed-locations.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:care-gaps": "tsx prisma/seed-care-gap-rules.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "form-data": "^4.0.6",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
