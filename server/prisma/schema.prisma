generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  NURSE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum OtpPurpose {
  PATIENT_LOGIN
}

enum AuditActorType {
  USER
  SYSTEM
}

enum PregnancyCaseStatus {
  ACTIVE
  COMPLETED
  CLOSED
}

enum CareEventType {
  INITIAL_INTAKE
  ANTENATAL_VISIT
  POSTNATAL_VISIT
  HOME_VISIT
  PHONE_FOLLOW_UP
  MANUAL_OBSERVATION
  REFERRAL_DISCUSSION
}

enum CareSourceType {
  MANUAL
  VOICE
  IMPORTED
}

enum VerificationStatus {
  DRAFT
  REVIEWED
  CONFIRMED
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IntakeRequestStatus {
  SUBMITTED
  PROCESSING
  READY_FOR_REVIEW
  VERIFIED
  REJECTED
}

enum ExtractedFieldStatus {
  UNCONFIRMED
  CONFIRMED
  REJECTED
}

enum TaskPriority {
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AlertSeverity {
  INFORMATIONAL
  HIGH
  EMERGENCY
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String     @id @default(cuid())
  role         UserRole
  status       UserStatus @default(ACTIVE)
  publicId     String?    @unique @map("public_id")
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?    @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  patientProfile     PatientProfile?
  staffProfile       StaffProfile?
  requestedOtps      OtpChallenge[]       @relation("OtpRequestedBy")
  createdAuditLogs   AuditLog[]           @relation("AuditActor")
  passwordResets     PasswordResetToken[]
  pregnancyCases     PregnancyCase[]      @relation("PatientPregnancyCases")
  assignedCases      PregnancyCase[]      @relation("AssignedPregnancyCases")
  createdCases       PregnancyCase[]      @relation("CreatedPregnancyCases")
  createdEvents      CareEvent[]          @relation("CreatedCareEvents")
  assignedTasks      FollowUpTask[]       @relation("AssignedFollowUpTasks")
  completedTasks     FollowUpTask[]       @relation("CompletedFollowUpTasks")
  patientTasks       FollowUpTask[]       @relation("PatientFollowUpTasks")
  confirmedFields    ExtractedField[]     @relation("ConfirmedExtractedFields")
  acknowledgedAlerts SafetyAlert[]        @relation("AcknowledgedSafetyAlerts")
  patientIntakeRequests PatientIntakeRequest[] @relation("PatientIntakeRequests")
  reviewedIntakeRequests PatientIntakeRequest[] @relation("ReviewedIntakeRequests")

  @@index([role, status])
  @@map("users")
}

model PatientProfile {
  userId                 String   @id @map("user_id")
  name                   String
  contactNumber          String?  @map("contact_number")
  dateOfBirth            DateTime @map("date_of_birth") @db.Date
  emergencyContactNumber String   @map("emergency_contact_number")
  address                String
  divisionId             String   @map("division_id")
  districtId             String   @map("district_id")
  upazilaId              String   @map("upazila_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  upazila  Upazila  @relation(fields: [upazilaId], references: [id])

  @@index([divisionId, districtId, upazilaId])
  @@map("patient_profiles")
}

model StaffProfile {
  userId     String   @id @map("user_id")
  employeeId String   @unique @map("employee_id")
  name       String
  address    String
  divisionId String   @map("division_id")
  districtId String   @map("district_id")
  upazilaId  String   @map("upazila_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  upazila  Upazila  @relation(fields: [upazilaId], references: [id])

  @@index([divisionId, districtId, upazilaId])
  @@map("staff_profiles")
}

model Division {
  id        String   @id
  nameBn    String   @map("name_bn")
  nameEn    String   @map("name_en")
  sortName  String   @map("sort_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts       District[]
  patientProfiles PatientProfile[]
  staffProfiles   StaffProfile[]

  @@unique([nameBn])
  @@unique([nameEn])
  @@index([sortName])
  @@map("divisions")
}

model District {
  id         String   @id
  divisionId String   @map("division_id")
  nameBn     String   @map("name_bn")
  nameEn     String   @map("name_en")
  sortName   String   @map("sort_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  division        Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas        Upazila[]
  patientProfiles PatientProfile[]
  staffProfiles   StaffProfile[]

  @@unique([divisionId, nameBn])
  @@unique([divisionId, nameEn])
  @@index([divisionId, sortName])
  @@map("districts")
}

model Upazila {
  id         String   @id
  districtId String   @map("district_id")
  nameBn     String   @map("name_bn")
  nameEn     String   @map("name_en")
  sortName   String   @map("sort_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  district        District         @relation(fields: [districtId], references: [id], onDelete: Restrict)
  patientProfiles PatientProfile[]
  staffProfiles   StaffProfile[]

  @@unique([districtId, nameBn])
  @@unique([districtId, nameEn])
  @@index([districtId, sortName])
  @@map("upazilas")
}

model PublicIdCounter {
  key       String   @id
  nextValue Int      @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("public_id_counters")
}

model OtpChallenge {
  id          String     @id @default(cuid())
  userId      String?    @map("user_id")
  purpose     OtpPurpose
  destination String
  codeHash    String     @map("code_hash")
  expiresAt   DateTime   @map("expires_at")
  attempts    Int        @default(0)
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  requestedBy User? @relation("OtpRequestedBy", fields: [userId], references: [id], onDelete: SetNull)

  @@index([destination, purpose, expiresAt])
  @@index([userId, purpose, createdAt])
  @@map("otp_challenges")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id          String         @id @default(cuid())
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id")
  action      String
  targetType  String         @map("target_type")
  targetId    String?        @map("target_id")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model PatientIntakeRequest {
  id                String              @id @default(cuid())
  patientUserId     String              @map("patient_user_id")
  status            IntakeRequestStatus @default(SUBMITTED)
  sourceType        CareSourceType      @default(VOICE) @map("source_type")
  audioStorageKey   String?             @map("audio_storage_key")
  originalFilename  String?             @map("original_filename")
  mimeType          String?             @map("mime_type")
  transcriptText    String?             @map("transcript_text")
  transcriptionStatus TranscriptionStatus @default(COMPLETED) @map("transcription_status")
  aiSummary         Json?               @map("ai_summary")
  submittedAt       DateTime            @default(now()) @map("submitted_at")
  reviewedAt        DateTime?           @map("reviewed_at")
  reviewedById      String?             @map("reviewed_by_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  patient   User  @relation("PatientIntakeRequests", fields: [patientUserId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedIntakeRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([patientUserId, status, submittedAt])
  @@index([status, submittedAt])
  @@map("patient_intake_requests")
}

model PregnancyCase {
  id                   String              @id @default(cuid())
  patientUserId        String              @map("patient_user_id")
  caseCode             String              @unique @map("case_code")
  status               PregnancyCaseStatus @default(ACTIVE)
  assignedStaffId      String?             @map("assigned_staff_id")
  createdByUserId      String              @map("created_by_user_id")
  lastMenstrualPeriod  DateTime?           @map("last_menstrual_period") @db.Date
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Date
  gravida              Int?
  para                 Int?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  patientUser   User           @relation("PatientPregnancyCases", fields: [patientUserId], references: [id], onDelete: Restrict)
  assignedStaff User?          @relation("AssignedPregnancyCases", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("CreatedPregnancyCases", fields: [createdByUserId], references: [id], onDelete: Restrict)
  careEvents    CareEvent[]
  followUpTasks FollowUpTask[]
  safetyAlerts  SafetyAlert[]

  @@index([patientUserId, status])
  @@index([assignedStaffId, status])
  @@map("pregnancy_cases")
}

model CareEvent {
  id                 String             @id @default(cuid())
  pregnancyCaseId    String             @map("pregnancy_case_id")
  eventType          CareEventType      @map("event_type")
  sourceType         CareSourceType     @map("source_type")
  verificationStatus VerificationStatus @default(DRAFT) @map("verification_status")
  summary            String?
  occurredAt         DateTime           @default(now()) @map("occurred_at")
  createdByUserId    String             @map("created_by_user_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  pregnancyCase   PregnancyCase    @relation(fields: [pregnancyCaseId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("CreatedCareEvents", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voiceNote       VoiceNote?
  extractedFields ExtractedField[]
  followUpTasks   FollowUpTask[]
  safetyAlerts    SafetyAlert[]

  @@index([pregnancyCaseId, occurredAt])
  @@map("care_events")
}

model VoiceNote {
  id                  String              @id @default(cuid())
  careEventId         String              @unique @map("care_event_id")
  storageKey          String              @map("storage_key")
  originalFilename    String?             @map("original_filename")
  mimeType            String?             @map("mime_type")
  durationSeconds     Int?                @map("duration_seconds")
  language            String              @default("bn-BD")
  transcriptionStatus TranscriptionStatus @default(PENDING) @map("transcription_status")
  transcriptText      String?             @map("transcript_text")
  transcriptionModel  String?             @map("transcription_model")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  careEvent       CareEvent        @relation(fields: [careEventId], references: [id], onDelete: Cascade)
  extractedFields ExtractedField[]

  @@map("voice_notes")
}

model ExtractedField {
  id            String               @id @default(cuid())
  careEventId   String               @map("care_event_id")
  voiceNoteId   String?              @map("voice_note_id")
  fieldKey      String               @map("field_key")
  value         Json
  confidence    Float?
  sourceText    String?              @map("source_text")
  status        ExtractedFieldStatus @default(UNCONFIRMED)
  confirmedById String?              @map("confirmed_by_id")
  confirmedAt   DateTime?            @map("confirmed_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  careEvent   CareEvent  @relation(fields: [careEventId], references: [id], onDelete: Cascade)
  voiceNote   VoiceNote? @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  confirmedBy User?      @relation("ConfirmedExtractedFields", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([careEventId, status])
  @@map("extracted_fields")
}

model FollowUpTask {
  id              String       @id @default(cuid())
  patientUserId   String       @map("patient_user_id")
  pregnancyCaseId String?      @map("pregnancy_case_id")
  sourceEventId   String?      @map("source_event_id")
  assignedStaffId String?      @map("assigned_staff_id")
  title           String
  reason          String
  priority        TaskPriority @default(NORMAL)
  dueAt           DateTime?    @map("due_at")
  status          TaskStatus   @default(OPEN)
  outcome         String?
  nextAction      String?      @map("next_action")
  completedAt     DateTime?    @map("completed_at")
  completedById   String?      @map("completed_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  patientUser   User           @relation("PatientFollowUpTasks", fields: [patientUserId], references: [id], onDelete: Restrict)
  pregnancyCase PregnancyCase? @relation(fields: [pregnancyCaseId], references: [id], onDelete: SetNull)
  sourceEvent   CareEvent?     @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  assignedStaff User?          @relation("AssignedFollowUpTasks", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  completedBy   User?          @relation("CompletedFollowUpTasks", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([assignedStaffId, status, dueAt])
  @@index([patientUserId, status])
  @@map("follow_up_tasks")
}

model SafetyAlert {
  id               String        @id @default(cuid())
  pregnancyCaseId  String        @map("pregnancy_case_id")
  careEventId      String?       @map("care_event_id")
  severity         AlertSeverity
  title            String
  reason           String
  sourceFacts      Json          @map("source_facts")
  status           AlertStatus   @default(OPEN)
  acknowledgedById String?       @map("acknowledged_by_id")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  pregnancyCase  PregnancyCase @relation(fields: [pregnancyCaseId], references: [id], onDelete: Cascade)
  careEvent      CareEvent?    @relation(fields: [careEventId], references: [id], onDelete: SetNull)
  acknowledgedBy User?         @relation("AcknowledgedSafetyAlerts", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([pregnancyCaseId, status])
  @@map("safety_alerts")
}
