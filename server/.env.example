DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/maternacare_db?schema=public"
PORT=5050
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-random-service-token
BANGLADESH_LOCATIONS_SOURCE_URL=https://bangladesh.gov.bd/views/upazila-list/
GOOGLE_MAPS_SERVER_API_KEY=replace-with-a-server-restricted-google-maps-key
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_DELIVERY_MODE=console
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login-email
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_EMAIL=MaternaCare <your-verified-sender@example.com>

# Required only when running the admin seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-secret
